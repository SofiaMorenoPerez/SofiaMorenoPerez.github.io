---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import siteConfig from '@/site.config';

const stack = [
  { name: 'Java', category: 'Backend', detail: 'Spring Boot, JPA, seguridad y autenticación.' },
  { name: 'Angular', category: 'Frontend', detail: 'Interfaces y consumo de APIs REST.' },
  { name: 'MySQL', category: 'Bases de datos', detail: 'Modelado, normalización y consultas SQL.' },
  { name: 'Git y GitHub', category: 'Herramientas', detail: 'Control de versiones y despliegue.' },
];
---

<BaseLayout
  title="Sobre mí"
  description={`Sobre ${siteConfig.author}, estudiante de la Universidad El Bosque.`}
>
  <Header />

  <main id="main" tabindex="-1">
    <section class="about-hero">
      <Container size="xl">
        <GlassPanel
          variant="solid"
          padding="xl"
          radius="xl"
          className="about-hero__panel"
        >
          <div class="about-hero__meta">
            <span>Sobre mí</span>
            <span>Universidad El Bosque</span>
          </div>

          <div class="about-hero__body">
            <div class="about-hero__title">
              <p>{siteConfig.author}</p>
              <h1>Aprendiendo y construyendo, un proyecto a la vez.</h1>
            </div>
            <div class="about-hero__statement">
              <p>
                Este espacio nació de mis clases en la universidad, pero se ha ido
                convirtiendo en algo más: un lugar donde documento lo que aprendo
                y lo que voy construyendo.
              </p>
            </div>
          </div>

          <div class="about-hero__footer">
            <span aria-hidden="true">✦</span>
            <div class="about-hero__actions">
              {
                siteConfig.social.github && (
                  <Button
                    href={siteConfig.social.github}
                    external
                    variant="solid"
                    size="lg"
                  >
                    Ver GitHub <span aria-hidden="true">↗</span>
                  </Button>
                )
              }
              {
                siteConfig.social.email && (
                  <Button href={siteConfig.social.email} variant="outline" size="lg">
                    Escríbeme
                  </Button>
                )
              }
            </div>
          </div>
        </GlassPanel>
      </Container>
    </section>

    <Section
      id="stack"
      eyebrow="Herramientas"
      title="Con lo que trabajo."
      subtitle="Lo que voy usando y aprendiendo a lo largo de mi formación."
      align="left"
      container="xl"
    >
      <ol class="stack-list">
        {
          stack.map((item, index) => (
            <li>
              <span class="stack-list__number">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="stack-list__category">{item.category}</span>
              <strong>{item.name}</strong>
              <p>{item.detail}</p>
            </li>
          ))
        }
      </ol>
    </Section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }

  .about-hero {
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .about-hero__panel {
    min-height: min(40rem, calc(100vh - 8rem)); /* fallback */
    min-height: min(40rem, calc(100dvh - 8rem));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .about-hero__meta,
  .about-hero__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .about-hero__meta {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--glass-border);
  }

  .about-hero__body {
    display: grid;
    grid-template-columns: minmax(20rem, 1.4fr) minmax(17rem, 0.6fr);
    align-items: end;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .about-hero__title > p {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  h1 {
    max-width: 14ch;
    margin: var(--space-lg) 0 0;
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .about-hero__statement {
    padding-left: var(--space-xl);
    border-left: 1px solid var(--glass-border);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .about-hero__statement p:last-child {
    margin-bottom: 0;
  }

  .about-hero__footer {
    align-items: flex-end;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--glass-border);
  }

  .about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-sm);
  }

  .stack-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--glass-border);
  }

  .stack-list li {
    display: grid;
    grid-template-columns: 3rem 8rem minmax(12rem, 0.65fr) minmax(18rem, 1fr);
    align-items: baseline;
    gap: var(--space-lg);
    margin: 0;
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--glass-border);
  }

  .stack-list__number,
  .stack-list__category {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .stack-list strong {
    font-size: var(--text-xl);
  }

  .stack-list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .about-hero__body {
      grid-template-columns: 1fr;
    }

    .stack-list li {
      grid-template-columns: 2.5rem 1fr;
    }

    .stack-list strong,
    .stack-list p {
      grid-column: 2;
    }
  }

  @media (max-width: 640px) {
    .about-hero__meta,
    .about-hero__footer {
      align-items: flex-start;
      flex-direction: column;
    }

    .about-hero__body {
      gap: var(--space-2xl);
    }

    .about-hero__statement {
      padding: var(--space-xl) 0 0;
      border-top: 1px solid var(--glass-border);
      border-left: 0;
    }

    .about-hero__actions {
      justify-content: flex-start;
    }
  }
</style>