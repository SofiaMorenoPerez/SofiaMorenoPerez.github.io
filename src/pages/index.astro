---
import BaseLayout from '@/layouts/BaseLayout.astro';
import siteConfig from '@/site.config';
import { withBase } from '@/lib/url';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import Section from '@/components/ui/Section.astro';
import { Image } from 'astro:assets';
import sofiaPhoto from '@/assets/images/sofia.jpg';




const highlights = [
  {
    
    title: 'Proyectos',
    description: 'Trabajos académicos y personales que voy desarrollando: desde aplicaciones completas hasta ejercicios de clase. Un espacio que se va actualizando con el tiempo.',
    href: '/work/',
    cta: 'Ver proyectos',
  },
  {
    title: 'Evidencias',
    description: 'El proceso detrás de cada trabajo: análisis, diseño y desarrollo, documentado paso a paso.',
    href: '/evidencias/',
    cta: 'Ver evidencias',
  },
];
---

<BaseLayout
  title="Sofia Moreno - Portafolio"
  description="Portafolio de Sofia Moreno, estudiante de Universidad El Bosque: proyectos en Java y bases de datos."
>
  <Header />

  <main id="main" tabindex="-1">
    <section class="home-hero">
      <Container size="xl">
        <div class="home-hero__meta">
          <span>Presentación</span>
          <span>2026</span>
        </div>
        <div class="home-hero__profile">
          <Image src={sofiaPhoto} alt="Sofia Moreno" width={260} height={260} class="home-hero__photo" />
          <div>
            <h1>Sofia Moreno<span>Perez</span></h1>
            <p class="home-hero__bio">
              Estudiante de Ingeniería de Sistemas en la Universidad El Bosque.Este es mi espacio para documentar proyectos, ideas y todo lo que voy aprendiendo a lo largo de este camino estudiantil.
            </p>
            <div class="home-hero__actions">
              <Button id="open-video" variant="solid" size="lg">Ver mi video de presentación▶</Button>
              {siteConfig.social.github && (
                <Button href={siteConfig.social.github} external variant="outline" size="lg">GitHub ↗</Button>
              )}
            </div>
          </div>
        </div>
      </Container>
    </section>

    <dialog id="video-modal">
      <button id="close-video" aria-label="Cerrar">✕</button>
      <div class="video-wrapper">
        <iframe
          src="https://youtu.be/k0qyeGJlBas"
          title="Video de presentación"
          frameborder="0"
          allow="autoplay; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>
    </dialog>

    <script>
      const dialog = document.getElementById('video-modal') as HTMLDialogElement;
      const iframe = document.querySelector('#video-modal iframe') as HTMLIFrameElement;
      const videoSrc = iframe.src;

      function closeVideo() {
        dialog.close();
        iframe.src = ''; // detiene el video quitando el src
      }

      document.getElementById('open-video')?.addEventListener('click', () => {
        iframe.src = videoSrc; // vuelve a cargar el video al abrir
        dialog.showModal();
      });

      document.getElementById('close-video')?.addEventListener('click', closeVideo);

      // También cierra si haces click fuera del video (en el fondo oscuro)
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) closeVideo();
      });

      // También cierra con la tecla Escape (el <dialog> ya lo hace solo, pero así también pausamos el video)
      dialog.addEventListener('close', () => {
        iframe.src = '';
      });
    </script>

    <Section
      id="highlights"
      eyebrow="Portafolio"
      title="Un espacio en constante crecimiento."
      subtitle="Proyectos, ideas y evidencias que voy documentando a lo largo de mi formación."
      align="left"
      container="xl"
    >
    
      <div class="highlights-list">
        {highlights.map((item) => (
          <GlassCard padding="lg" radius="xl" class="highlight-card">
            <h2>{item.title}</h2>
            <p>{item.description}</p>
            <a href={withBase(item.href)}>
              {item.cta}
              <span aria-hidden="true"> →</span>
            </a>
          </GlassCard>
        ))}
      </div>
    </Section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }

  .home-hero {
    position: relative;
    min-height: min(54rem, calc(100vh - 5rem)); /* fallback */
    min-height: min(54rem, calc(100dvh - 5rem));
    display: grid;
    align-items: center;
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .home-hero__meta {
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--glass-border);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .home-hero__profile {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-2xl);
    margin-block: clamp(3rem, 8vw, 6rem);
  }

  .home-hero__photo {
    border-radius: 50%;
    border: 3px solid var(--color-accent);
    object-fit: cover;
    width: 220px;
    height: 220px;
  }

  .home-hero__profile h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .home-hero__profile h1 span {
    display: block;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .home-hero__bio {
    margin-block: var(--space-lg);
    max-width: 40rem;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  dialog#video-modal {
    border: none;
    border-radius: var(--radius-xl);
    padding: var(--space-lg);
    background: var(--color-surface);
    max-width: 48rem;
    width: 90vw;
  }

  dialog#video-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .video-wrapper {
    position: relative;
    padding-top: 56.25%;
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
  }

  #close-video {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.7);
    border: none;
    color: white;
    font-size: var(--text-lg);
    cursor: pointer;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .highlights-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-xl);
  }

  .highlight-card h2 {
    margin-bottom: var(--space-sm);
    font-size: var(--text-2xl);
  }

  .highlight-card p {
    margin-bottom: var(--space-lg);
    color: var(--color-text-muted);
  }

  .highlight-card a {
    display: inline-flex;
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .home-hero__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .home-hero__profile {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
  }
</style>